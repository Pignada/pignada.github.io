---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{%- assign services_tries = site.services | sort: "ordre" %}
{%- for s in services_tries %}
  <url><loc>{{ site.url }}{{ s.url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
  <url><loc>{{ site.url }}/conseils/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{%- for a in site.conseils %}
  <url><loc>{{ site.url }}{{ a.url }}</loc><lastmod>{{ a.date | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
  <url><loc>{{ site.url }}/mentions-legales.html</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
</urlset>
